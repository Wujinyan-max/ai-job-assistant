# ======================== 部署配置 ========================
# 复制此文件为 .env 并填入真实值，然后运行 docker compose up -d

# MySQL root 密码（必填，建议 32 位随机字符串）
DB_ROOT_PASSWORD=

# JWT 签名密钥（必填，HS256 要求 >= 256 bit，即 32 字节以上）
# 生成命令：openssl rand -base64 48
JWT_SECRET=

# AI 用户配置加密密钥（必填，32 位随机字符串）
# 生成命令：openssl rand -hex 32
AI_CONFIG_ENCRYPTION_KEY=

# ------------------------- 限流（可选）-------------------------
# 不填则用 application.yml 里的默认值
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REGISTER_MAX=3        # 同 IP 每窗口注册次数
# RATE_LIMIT_REGISTER_TOTAL=10     # 同 IP 注册累计上限

# ------------------------- AI（可选）-------------------------
# 不填则使用本地模拟引擎，功能完全可用
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
